# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Must equal FRONTEND_URL on the real deployment — this is the DEMO_MODE
# safety gate (see server/routes/auth.js). Leave unset locally so it never
# matches FRONTEND_URL, keeping DEMO_MODE effective for local dev/demo use.
# PRODUCTION_FRONTEND_URL=https://rmt.internal.marslab.local

# Authentication Secrets (Must be at least 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
REFRESH_SECRET=your_refresh_secret_at_least_32_chars_long
DEMO_MODE=true

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=marslab_user
PGPASSWORD=marslab123
PGDATABASE=marslab_db

# Email / SMTP Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Renewals <renewals@sidcorptech.net>"

# Zoho Integrations — left unset on the on-prem deployment by design (see
# charts/rmt/README.md "Network policy for this deployment: SMTP only").
# ZOHO_CLIQ_WEBHOOK_URL/ZOHO_CLIQ_SALES_WEBHOOK_URL unset -> Cliq
# notifications degrade to a console-log simulation (server/services/
# cliqService.js). ZOHO_BOOKS_WEBHOOK_SECRET unset -> the Books webhook route
# fails closed (401) on every request, same as leaving it disabled.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3001/api/auth/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIQ_WEBHOOK_URL=
ZOHO_CLIQ_SALES_WEBHOOK_URL=
ZOHO_BOOKS_WEBHOOK_SECRET=

# Object storage (visit photos) — S3-compatible, points at MinIO on-prem.
# Unset -> server/services/objectStorage.js no-ops and visit photos keep
# storing inline as base64 in visits.photo_data (legacy path).
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rmt-visit-photos

# AI Agent
# Without this set, server/agent/geminiClient.js returns a null client for
# every call and the whole agent subsystem (intent classification, outreach
# drafting, natural-language edits, answer_data_question) silently runs on
# its regex/rule-based fallback path instead of the LLM. The server logs a
# one-time startup warning when this is unset.
GEMINI_API_KEY=
# Optional — defaults shown below (server/agent/geminiClient.js). Google's
# free tier caps this key at 20 generate-content requests/day and 5/minute;
# by policy this app only ever self-limits to 30% of that (6/day, 1/minute)
# so ad-hoc testing can't burn the whole day's real quota before real usage
# gets a turn. Raise these explicitly once the key is on a paid plan.
# AGENT_MAX_REQUESTS_PER_DAY=6
# AGENT_MAX_REQUESTS_PER_MINUTE=1
# AGENT_MAX_DAILY_USD=10
